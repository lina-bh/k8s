{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/ublue-os/brew"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "k3s-io/k3s"
      ],
      "separateMultipleMinor": true
    }
  ],
  "prHourlyLimit": 0,
  "quadlet": {
    "managerFilePatterns": [
      "/.+\\.container.d/.+\\.conf$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^k8s/apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^k8s/apps/.+\\.ya?ml$/"
    ]
  }
}
