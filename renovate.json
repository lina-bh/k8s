{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "k3s-io/k3s"
      ],
      "separateMultipleMinor": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/home-operations/sonarr",
        "registry.k8s.io/nfd/charts/node-feature-discovery",
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "tailscale-operator"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "1 day",
      "automerge": true
    }
  ],
  "prHourlyLimit": 0,
  "automergeType": "branch",
  "ignoreTests": true,
  "quadlet": {
    "managerFilePatterns": [
      "/.+\\.container.d/.+\\.conf$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^k8s/apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^k8s/apps/.+\\.ya?ml$/"
    ]
  }
}
