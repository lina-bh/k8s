{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automergeType": "branch",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions",
    "docker:pinDigests",
    "github>home-operations/renovate-presets//apps/cnpg.json5"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^apps/.+\\.ya?ml$/",
      "/^clusters/oke/.+\\.ya?ml$/"
    ]
  },
  "ignoreTests": true,
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+\\.ya?ml$/",
      "/^clusters/oke/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "automerge": true,
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ]
    },
    {
      "automerge": true,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/prowlarr",
        "registry.k8s.io/nfd/charts/node-feature-discovery",
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds",
        "ghcr.io/recyclarr/recyclarr",
        "ghcr.io/victoriametrics/helm-charts/victoria-metrics-k8s-stack",
        "ghcr.io/project-zot/helm-charts/zot"
      ],
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "automerge": true,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/external-secrets/charts/external-secrets"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "automerge": true,
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "tailscale-operator"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/jellyfin/jellyfin"
      ],
      "separateMultipleMinor": true
    },
    {
      "automerge": true,
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/cloudnative-pg/artifacts.git"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "enabled": false,
      "matchFileNames": [
        ".mise/locks/**"
      ]
    }
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0
}
