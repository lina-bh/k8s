[Container]
Image=ghcr.io/openbao/openbao:2.6
Volume=/etc/openbao.d:/openbao/config:ro,U,Z,noexec
Volume=/var/lib/openbao:/var/lib/openbao:U,Z,noexec
User=963
Group=963
UserNS=auto:uidmapping=963:963:1,gidmapping=963:963:1
ReadOnly=true
ReadOnlyTmpfs=false
PublishPort=0.0.0.0:8200:8200/tcp
AddCapability=IPC_LOCK
Exec=server
Environment=BAO_ADDR=http://127.0.0.1:8200
Secret=bao_secret_key,type=env,target=bao_secret_key
HealthStartupCmd=["wget", "--spider", "http://127.0.0.1:8200/v1/sys/health?standbyok=true&uninitok=true&sealedcode=200"]
HealthCmd=["wget", "--spider", "http://127.0.0.1:8200/v1/sys/health?standbyok=true"]
Notify=healthy

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
