[Unit]
Requires=postgres18.service
Wants=invidious-companion.service

[Kube]
Yaml=./invidious-deployment.yaml
Network=invidious.network
Network=postgres18.network

[Service]
Restart=on-failure
ExecStartPost=/usr/bin/tailscale serve --bg --yes --https 443 --service svc:iv http://localhost:3000/

[Install]
WantedBy=default.target
